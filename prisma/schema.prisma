// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
//  provider = "sqlite"
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model YearlyArrivals {
  year  Int @id @unique // 年 (主キー)
  count Int          // 総入国者数
}

model CountryExpenditure {
  id                 Int     @id @default(autoincrement()) // 自動インクリメントID (主キー)
  country            String  // 国名
  year               Int     // 年
  averageExpenditure Float   // 1人あたり平均支出額

  @@unique([country, year]) // 国名と年の組み合わせでユニーク
}

model CountryArrivals {
  id      Int    @id @default(autoincrement())
  country String
  year    Int
  count   Int

  @@unique([country, year])
}
